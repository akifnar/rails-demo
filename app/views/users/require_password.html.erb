<div>
  <% if flash[:notice] %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2>Prohibited this action from being saved:</h2>
      <ul class="list-disc ml-6">
        <li><%= flash[:notice] %></li>
      </ul>
    </div>
  <% end %>


  <h2>Please Enter your old password</h2>


  <div class="my-5">
    <%= form_with url: check_password_user_path(@user), method: :post do |form| %>

      <div class="mb-5">
        <%= form.password_field :old_password, placeholder: "1234", class:"input-field" %>
      </div>

      <div>
        <%= form.submit "submit", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      </div>

    <% end %>
  </div>

</div>