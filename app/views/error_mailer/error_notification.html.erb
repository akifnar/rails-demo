<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  </head>
  <body style="background-color: #f8fafc; font-family: ui-sans-serif, system-ui, sans-serif; padding: 20px;">
    
    <div style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
      
      <div style="background-color: #dc2626; padding: 16px 24px;">
        <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: 600;">
          An Application Failure Occurred!
        </h1>
      </div>

      <div style="padding: 24px;">
        <p style="margin-bottom: 8px; color: #475569; font-weight: 700; text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em;">
          Error Message:
        </p>
        <p style="color: #1e293b; font-size: 16px; margin-bottom: 24px;">
          <%= @message %>
        </p>

        <p style="margin-bottom: 8px; color: #475569; font-weight: 700; text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em;">
          Time (UTC):
        </p>
        <p style="color: #1e293b; font-size: 14px; margin-bottom: 24px;">
          <%= Time.now.strftime("%B %d, %Y %H:%M:%S") %>
        </p>

        <p style="margin-bottom: 8px; color: #475569; font-weight: 700; text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em;">
          Backtrace:
        </p>
        <pre style="background-color: #0f172a; color: #f1f5f9; padding: 16px; border-radius: 6px; font-size: 12px; overflow-x: auto; line-height: 1.5;">
<%= @backtrace.join("\n") %>
        </pre>
      </div>

      <div style="background-color: #f1f5f9; padding: 12px 24px; text-align: center;">
        <p style="color: #94a3b8; font-size: 12px; margin: 0;">
          This is an automated system notification.
        </p>
      </div>

    </div>
  </body>
</html>